rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // v7 개인용 백업을 유지합니다. 각 계정 본인만 접근할 수 있습니다.
    match /hilfuStates/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 최초 배포 전, 감독이 v8 화면에서 확인한 Firebase Auth UID로 변경하세요.
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'PASTE_OWNER_UID_HERE';
    }
    function verifiedEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function isInvitedEditor() {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/hilfuTeamAccess/official)
        && request.auth.token.email in get(/databases/$(database)/documents/hilfuTeamAccess/official).data.editorEmails;
    }
    function validTeamDoc() {
      return request.resource.data.keys().hasAll(['ownerUid', 'state', 'revision', 'version', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'state', 'revision', 'version', 'updatedAt'])
        && request.resource.data.ownerUid is string
        && request.resource.data.state is map
        && request.resource.data.revision is int
        && request.resource.data.version is int;
    }
    match /hilfuTeams/{teamId} {
      // 공식 팀 보드 한 문서는 로그인 없이 누구나 읽을 수 있습니다. 쓰기는 감독/승인 코치만 허용합니다.
      allow get: if teamId == 'official';
      allow list: if false;
      allow create: if teamId == 'official'
        && isOwner()
        && validTeamDoc()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.revision == 1;
      allow update: if teamId == 'official'
        && (isOwner() || isInvitedEditor())
        && validTeamDoc()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['state', 'revision', 'version', 'updatedAt']);
      allow delete: if false;
    }
    match /hilfuTeamAccess/{teamId} {
      // 이메일 허용목록은 감독과 초대된 편집자만 읽을 수 있습니다.
      // 자기 자신의 ACL get에서 다시 get()을 호출하지 않도록 resource.data 사용.
      allow get: if teamId == 'official'
        && (isOwner() || (verifiedEmail()
            && request.auth.token.email in resource.data.editorEmails));
      allow list: if false;
      allow create: if teamId == 'official'
        && isOwner()
        && request.resource.data.keys().hasAll(['ownerUid', 'editorEmails', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'editorEmails', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.editorEmails is list
        && request.resource.data.editorEmails.size() <= 20;
      allow update: if teamId == 'official'
        && isOwner()
        && request.resource.data.keys().hasOnly(['ownerUid', 'editorEmails', 'updatedAt'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.editorEmails is list
        && request.resource.data.editorEmails.size() <= 20
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['editorEmails', 'updatedAt']);
      allow delete: if false;
    }
    // v8.4 경기 이력: 공식 보드에서 보관된 경기 전체를 로그인 없이 열람.
    // 새 기록 생성은 감독 또는 승인된 코치만 가능하며 수정/삭제는 금지합니다.
    match /hilfuMatchArchive/{matchId} {
      allow get, list: if true;
      allow create: if (isOwner() || isInvitedEditor())
        && request.resource.data.keys().hasAll(['state', 'title', 'date', 'sourceRevision', 'createdAt', 'actorUid'])
        && request.resource.data.keys().hasOnly(['state', 'title', 'date', 'sourceRevision', 'createdAt', 'actorUid'])
        && request.resource.data.state is map
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.date is string
        && request.resource.data.sourceRevision is int
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // v8.4 공식 수정 전 백업: 최근 10개 슬롯을 순환 저장, 복원은 승인 편집자만.
    // 비로그인 선수는 백업 내용 및 편집자 관리 문서를 읽을 수 없습니다.
    match /hilfuTeamBackups/{backupId} {
      allow get, list: if isOwner() || isInvitedEditor();
      allow create, update: if (isOwner() || isInvitedEditor())
        && backupId.matches('slot[0-9]')
        && request.resource.data.keys().hasAll(['state', 'sourceRevision', 'reason', 'actorUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['state', 'sourceRevision', 'reason', 'actorUid', 'createdAt'])
        && request.resource.data.state is map
        && request.resource.data.sourceRevision is int
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 80
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
